{
  "name": "anchor-study-desktop",
  "version": "0.1.0",
  "description": "Anchor — the desktop app. Premium study + organisation, with native reminders and a menu-bar widget.",
  "main": "main.js",
  "bin": {
    "anchor": "bin/anchor.js"
  },
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "author": "Anchor",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.7.6",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "app.anchor.study",
    "productName": "Anchor",
    "files": ["main.js", "preload.js", "bin/**/*", "assets/**/*"],
    "mac": {
      "category": "public.app-category.education",
      "icon": "assets/icon.png",
      "target": ["dmg", "zip"]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": ["nsis"]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": ["AppImage"],
      "category": "Education"
    }
  }
}
