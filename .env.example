# ─────────────────────────────────────────────────────────────
# Anchor environment variables
# Copy to .env.local for local dev. Add the same vars in Vercel.
# Supabase is REQUIRED for accounts/sign-in. OpenRouter is recommended for real
# AI (a built-in generator is used only as a silent fallback if a call fails).
# ─────────────────────────────────────────────────────────────

# ── Supabase (REQUIRED — accounts + database + cross-device sync) ──
# From Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── OpenRouter (real AI generation) ──
# Key from https://openrouter.ai/keys — kept server-side only.
OPENROUTER_API_KEY=
# Any OpenRouter model id, e.g. openai/gpt-4o-mini, google/gemini-flash-1.5,
# anthropic/claude-3.5-sonnet, meta-llama/llama-3.1-70b-instruct
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional: your deployed URL (used in OpenRouter request headers)
# OPENROUTER_SITE_URL=https://your-app.vercel.app

# ── Canvas LMS (optional — sync courses & assignments) ──
# Your institution's Canvas base URL, e.g. https://yourschool.instructure.com
# and a personal access token (Canvas → Account → Settings → + New Access Token).
# Server-only — never exposed to the browser.
CANVAS_BASE_URL=
CANVAS_TOKEN=
