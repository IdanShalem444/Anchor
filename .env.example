# ─────────────────────────────────────────────────────────────
# Anchor environment variables
# Copy to .env.local for local dev. Add the same vars in Vercel.
# Supabase is REQUIRED for accounts/sign-in. OpenRouter is recommended for real
# AI (a built-in generator is used only as a silent fallback if a call fails).
# ─────────────────────────────────────────────────────────────

# ── Supabase (REQUIRED — accounts + database + cross-device sync) ──
# From Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Claude (Anthropic) — preferred AI; takes priority over OpenRouter when set ──
# Key from https://console.anthropic.com (paid — no free tier). Server-side only.
ANTHROPIC_API_KEY=
# claude-opus-4-8 (most capable), claude-sonnet-4-6 (cheaper), claude-haiku-4-5 (cheapest)
ANTHROPIC_MODEL=claude-opus-4-8

# ── OpenRouter / any OpenAI-compatible provider (real AI generation) ──
# This block drives ANY OpenAI-compatible API by changing 3 vars. NOTE: if
# ANTHROPIC_API_KEY above is set, Claude is used first — leave it blank to use this.
# Key — kept server-side only.
OPENROUTER_API_KEY=
# Model id for the chosen provider.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional comma-separated fallback models — tried in order when the primary is
# rate-limited/unavailable (great for keeping FREE models working for everyone),
# e.g. nvidia/nemotron-3-super-120b-a12b:free,qwen/qwen3-next-80b-a3b-instruct:free
OPENROUTER_FALLBACK_MODELS=
# Base URL — leave unset for OpenRouter; override to point at another provider.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: your deployed URL (used in OpenRouter request headers)
# OPENROUTER_SITE_URL=https://your-app.vercel.app
#
# ── DeepSeek — two ways ──
# A) DeepSeek directly (key from https://platform.deepseek.com):
#      OPENROUTER_BASE_URL=https://api.deepseek.com
#      OPENROUTER_API_KEY=<your DeepSeek key>
#      OPENROUTER_MODEL=deepseek-chat        # or deepseek-reasoner (R1)
# B) DeepSeek via OpenRouter (keep your OpenRouter key, no base URL change):
#      OPENROUTER_MODEL=deepseek/deepseek-chat            # paid (needs credits)
#      OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free  # free tier

# ── Canvas LMS (optional — sync courses & assignments) ──
# Your institution's Canvas base URL, e.g. https://yourschool.instructure.com
# and a personal access token (Canvas → Account → Settings → + New Access Token).
# Server-only — never exposed to the browser.
CANVAS_BASE_URL=
CANVAS_TOKEN=
